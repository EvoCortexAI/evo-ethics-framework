{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evocortex.ai/schemas/evo-ethics/v1/control-catalog.schema.json",
  "title": "EvoEthics Control Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "ethics_source_version", "controls"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "catalog_version": { "type": "string", "minLength": 1 },
    "ethics_source_version": { "type": "string", "minLength": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "phases", "principles", "effect", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^EC-[A-Z0-9]+-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "phases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["runtime", "design"] }
          },
          "principles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9", "E10"] }
          },
          "effect": {
            "enum": ["allow_with_obligations", "require_approval", "require_review", "deny"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "obligations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
